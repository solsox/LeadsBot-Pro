cat > .gitignore << 'EOF'
# ─── Credenciales y config sensible ───
email_settings.json
email_accounts.json
.env
.env.local
.env.*.local

# ─── Estado interno del CRM / campañas ───
lead_status.json
lead_emails.json
tracking_events.json
worker_state.json
search_config.json
search_mode.json
campaigns_data/
sources_data/

# ─── Datos de leads (privacidad de contactos) ───
leads_raw.json
leads_scored.json
leads_ready.json
send_results.json
data/

# ─── WhatsApp ───
WHATSAPP_IA/
PyWhatKit_DB.txt

# ─── Datos de negocio (CSV/XLSX con clientes) ───
*.csv
*.xlsx
*.xls

# ─── Python ───
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ─── Node / Next ───
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# ─── Logs ───
*.log
npm-debug.log*
yarn-debug.log*

# ─── Sistema / Editores ───
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
EOF